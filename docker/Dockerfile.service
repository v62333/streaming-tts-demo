# 雲端串流 TTS 服務映像
# 模型權重不打包進映像（OpenRAIL-M 不重新散布）：執行時用 -v 掛載 models/
#   docker build -f docker/Dockerfile.service -t stts-service .
#   docker run --rm -p 8800:8800 --cpus=4 -v "$PWD/models":/app/models:ro stts-service
FROM python:3.12-slim
RUN pip install --no-cache-dir onnxruntime==1.32.0 numpy
WORKDIR /app
COPY src/ src/
COPY third_party/ third_party/
COPY service/ service/
ENV PYTHONUNBUFFERED=1 MODEL_VARIANT=int8 ORT_THREADS=1 MAX_CONCURRENT=2 MAX_QUEUE=8 PORT=8800
EXPOSE 8800
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8800/healthz').status==200 else 1)"
CMD ["python", "service/tts_service.py"]
